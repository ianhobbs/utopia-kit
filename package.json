{
  "name": "@ianhobbs/utopia-kit",
  "version": "1.0.0",
  "description": "A kit with a simple set of scripts to generate utopia css to integrate into tailwind css",
  "keywords": [
    "tailwind",
    "utopia"
  ],
  "homepage": "https://github.com/ianhobbs/utopia-kit#readme",
  "bugs": {
    "url": "https://github.com/ianhobbs/utopia-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianhobbs/utopia-kit.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "Ian Hobbs",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "convert-utopia": "node convertVariables.js",
    "tails": "npx @tailwindcss/cli -i ./source/assets/css/main.css -o ./public/assets/css/main.css -wm"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "utopia-core-scss": "^1.3.0"
  }
}
